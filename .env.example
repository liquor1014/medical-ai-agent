# 复制为 .env 后按需修改（Docker Compose 会自动读取根目录 .env）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medical_ai
POSTGRES_USER=medical
POSTGRES_PASSWORD=medical123
# AI 服务连接串（本地开发用；Docker Compose 会自动改为 postgres 主机）
POSTGRES_DSN=postgresql://medical:medical123@localhost:5432/medical_ai

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=medical-docs

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=medical_docs

AI_SERVICE_URL=http://localhost:8000

# 登录 JWT（生产环境务必替换 secret）
JWT_SECRET=medical-ai-dev-only-jwt-signing-secret-change-me-in-production-2026
JWT_EXPIRE_HOURS=12

# 完整栈前端对外端口
WEB_PORT=5173

# 模型 API Key（按需填写）
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=

# 多模型路由（按顺序尝试，失败自动降级；mock 为兜底）
LLM_ROUTE_CHAT=deepseek,qwen,openai,mock
LLM_ROUTE_NL2SQL=deepseek,qwen,openai,mock
LLM_ROUTE_REPORT=deepseek,qwen,openai,mock
LLM_TIMEOUT_SECONDS=20
LLM_STREAM_IDLE_TIMEOUT=15
# 本地 Ollama（可选，无需 Key）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
